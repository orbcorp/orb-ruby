module Orb
  module Models
    type migration_cancel_response =
      {
        id: String,
        effective_time: Orb::Models::MigrationCancelResponse::effective_time?,
        ended_at: Time?,
        plan_id: String,
        started_at: Time?,
        status: Orb::Models::MigrationCancelResponse::status,
        target_plan_version_number: Integer
      }

    class MigrationCancelResponse < Orb::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor effective_time: Orb::Models::MigrationCancelResponse::effective_time?

      attr_accessor ended_at: Time?

      attr_accessor plan_id: String

      attr_accessor started_at: Time?

      attr_accessor status: Orb::Models::MigrationCancelResponse::status

      attr_accessor target_plan_version_number: Integer

      def initialize: (
        id: String,
        effective_time: Orb::Models::MigrationCancelResponse::effective_time?,
        ended_at: Time?,
        plan_id: String,
        started_at: Time?,
        status: Orb::Models::MigrationCancelResponse::status,
        target_plan_version_number: Integer
      ) -> void

      def to_hash: -> {
        id: String,
        effective_time: Orb::Models::MigrationCancelResponse::effective_time?,
        ended_at: Time?,
        plan_id: String,
        started_at: Time?,
        status: Orb::Models::MigrationCancelResponse::status,
        target_plan_version_number: Integer
      }

      type effective_time =
        Date
        | Time
        | :start_of_term
        | :end_of_term
        | :start_of_invoice
        | :end_of_invoice

      module EffectiveTime
        extend Orb::Internal::Type::Union

        def self?.variants: -> ::Array[Orb::Models::MigrationCancelResponse::effective_time]

        START_OF_TERM: :start_of_term
        END_OF_TERM: :end_of_term
        START_OF_INVOICE: :start_of_invoice
        END_OF_INVOICE: :end_of_invoice
      end

      type status =
        :not_started | :in_progress | :completed | :action_needed | :canceled

      module Status
        extend Orb::Internal::Type::Enum

        NOT_STARTED: :not_started
        IN_PROGRESS: :in_progress
        COMPLETED: :completed
        ACTION_NEEDED: :action_needed
        CANCELED: :canceled

        def self?.values: -> ::Array[Orb::Models::MigrationCancelResponse::status]
      end
    end
  end
end
