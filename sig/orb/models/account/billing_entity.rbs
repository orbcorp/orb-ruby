module Orb
  module Models
    module Account
      type billing_entity =
        {
          id: String,
          address: Orb::Address?,
          created_at: Time,
          default_payment_gateway_connection_id: String?,
          external_billing_entity_id: String?,
          invoice_settings: Orb::Account::BillingEntity::InvoiceSettings,
          is_default: bool,
          legal_name: String,
          name: String,
          payment_gateway_connections: ::Array[Orb::Account::BillingEntity::PaymentGatewayConnection],
          status: Orb::Models::Account::BillingEntity::status,
          tax_registrations: ::Array[Orb::Account::BillingEntity::TaxRegistration]
        }

      class BillingEntity < Orb::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor address: Orb::Address?

        attr_accessor created_at: Time

        attr_accessor default_payment_gateway_connection_id: String?

        attr_accessor external_billing_entity_id: String?

        attr_accessor invoice_settings: Orb::Account::BillingEntity::InvoiceSettings

        attr_accessor is_default: bool

        attr_accessor legal_name: String

        attr_accessor name: String

        attr_accessor payment_gateway_connections: ::Array[Orb::Account::BillingEntity::PaymentGatewayConnection]

        attr_accessor status: Orb::Models::Account::BillingEntity::status

        attr_accessor tax_registrations: ::Array[Orb::Account::BillingEntity::TaxRegistration]

        def initialize: (
          id: String,
          address: Orb::Address?,
          created_at: Time,
          default_payment_gateway_connection_id: String?,
          external_billing_entity_id: String?,
          invoice_settings: Orb::Account::BillingEntity::InvoiceSettings,
          is_default: bool,
          legal_name: String,
          name: String,
          payment_gateway_connections: ::Array[Orb::Account::BillingEntity::PaymentGatewayConnection],
          status: Orb::Models::Account::BillingEntity::status,
          tax_registrations: ::Array[Orb::Account::BillingEntity::TaxRegistration]
        ) -> void

        def to_hash: -> {
          id: String,
          address: Orb::Address?,
          created_at: Time,
          default_payment_gateway_connection_id: String?,
          external_billing_entity_id: String?,
          invoice_settings: Orb::Account::BillingEntity::InvoiceSettings,
          is_default: bool,
          legal_name: String,
          name: String,
          payment_gateway_connections: ::Array[Orb::Account::BillingEntity::PaymentGatewayConnection],
          status: Orb::Models::Account::BillingEntity::status,
          tax_registrations: ::Array[Orb::Account::BillingEntity::TaxRegistration]
        }

        type invoice_settings = { memo: String? }

        class InvoiceSettings < Orb::Internal::Type::BaseModel
          attr_accessor memo: String?

          def initialize: (memo: String?) -> void

          def to_hash: -> { memo: String? }
        end

        type payment_gateway_connection =
          {
            is_default: bool,
            payment_gateway_connection_id: String,
            payment_provider_type: Orb::Models::Account::BillingEntity::PaymentGatewayConnection::payment_provider_type
          }

        class PaymentGatewayConnection < Orb::Internal::Type::BaseModel
          attr_accessor is_default: bool

          attr_accessor payment_gateway_connection_id: String

          attr_accessor payment_provider_type: Orb::Models::Account::BillingEntity::PaymentGatewayConnection::payment_provider_type

          def initialize: (
            is_default: bool,
            payment_gateway_connection_id: String,
            payment_provider_type: Orb::Models::Account::BillingEntity::PaymentGatewayConnection::payment_provider_type
          ) -> void

          def to_hash: -> {
            is_default: bool,
            payment_gateway_connection_id: String,
            payment_provider_type: Orb::Models::Account::BillingEntity::PaymentGatewayConnection::payment_provider_type
          }

          type payment_provider_type = :stripe | :adyen

          module PaymentProviderType
            extend Orb::Internal::Type::Enum

            STRIPE: :stripe
            ADYEN: :adyen

            def self?.values: -> ::Array[Orb::Models::Account::BillingEntity::PaymentGatewayConnection::payment_provider_type]
          end
        end

        type status = :active | :archived

        module Status
          extend Orb::Internal::Type::Enum

          ACTIVE: :active
          ARCHIVED: :archived

          def self?.values: -> ::Array[Orb::Models::Account::BillingEntity::status]
        end

        type tax_registration =
          { applies_to: String?, code: String, value: String }

        class TaxRegistration < Orb::Internal::Type::BaseModel
          attr_accessor applies_to: String?

          attr_accessor code: String

          attr_accessor value: String

          def initialize: (
            applies_to: String?,
            code: String,
            value: String
          ) -> void

          def to_hash: -> { applies_to: String?, code: String, value: String }
        end
      end
    end
  end
end
