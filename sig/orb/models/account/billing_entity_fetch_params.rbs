module Orb
  module Models
    module Account
      type billing_entity_fetch_params =
        { billing_entity_id: String } & Orb::Internal::Type::request_parameters

      class BillingEntityFetchParams < Orb::Internal::Type::BaseModel
        extend Orb::Internal::Type::RequestParameters::Converter
        include Orb::Internal::Type::RequestParameters

        attr_accessor billing_entity_id: String

        def initialize: (
          billing_entity_id: String,
          ?request_options: Orb::request_opts
        ) -> void

        def to_hash: -> {
          billing_entity_id: String,
          request_options: Orb::RequestOptions
        }
      end
    end
  end
end
