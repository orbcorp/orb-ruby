module Orb
  module Models
    type webhook_endpoint =
      {
        id: String,
        created_at: Time,
        enabled: bool,
        enabled_event_types: ::Array[String]?,
        url: String
      }

    class WebhookEndpoint < Orb::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor created_at: Time

      attr_accessor enabled: bool

      attr_accessor enabled_event_types: ::Array[String]?

      attr_accessor url: String

      def initialize: (
        id: String,
        created_at: Time,
        enabled: bool,
        enabled_event_types: ::Array[String]?,
        url: String
      ) -> void

      def to_hash: -> {
        id: String,
        created_at: Time,
        enabled: bool,
        enabled_event_types: ::Array[String]?,
        url: String
      }
    end
  end
end
