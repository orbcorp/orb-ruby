module Orb
  module Resources
    class Plans
      attr_reader external_plan_id: Orb::Resources::Plans::ExternalPlanID

      attr_reader draft: Orb::Resources::Plans::Draft

      attr_reader migrations: Orb::Resources::Plans::Migrations

      def create: (
        currency: String,
        name: String,
        prices: ::Array[Orb::PlanCreateParams::Price],
        ?adjustments: ::Array[Orb::PlanCreateParams::Adjustment]?,
        ?default_invoice_memo: String?,
        ?description: String?,
        ?external_plan_id: String?,
        ?metadata: ::Hash[Symbol, String?]?,
        ?net_terms: Integer?,
        ?plan_phases: ::Array[Orb::PlanCreateParams::PlanPhase]?,
        ?status: Orb::Models::PlanCreateParams::status,
        ?request_options: Orb::request_opts
      ) -> Orb::Plan

      def update: (
        String plan_id,
        ?description: String?,
        ?external_plan_id: String?,
        ?metadata: ::Hash[Symbol, String?]?,
        ?name: String?,
        ?request_options: Orb::request_opts
      ) -> Orb::Plan

      def list: (
        ?created_at_gt: Time?,
        ?created_at_gte: Time?,
        ?created_at_lt: Time?,
        ?created_at_lte: Time?,
        ?cursor: String?,
        ?limit: Integer,
        ?status: Orb::Models::PlanListParams::status,
        ?request_options: Orb::request_opts
      ) -> Orb::Internal::Page[Orb::Plan]

      def create_plan_version: (
        String plan_id,
        version: Integer,
        ?add_adjustments: ::Array[Orb::PlanCreatePlanVersionParams::AddAdjustment]?,
        ?add_prices: ::Array[Orb::PlanCreatePlanVersionParams::AddPrice]?,
        ?remove_adjustments: ::Array[Orb::PlanCreatePlanVersionParams::RemoveAdjustment]?,
        ?remove_prices: ::Array[Orb::PlanCreatePlanVersionParams::RemovePrice]?,
        ?replace_adjustments: ::Array[Orb::PlanCreatePlanVersionParams::ReplaceAdjustment]?,
        ?replace_prices: ::Array[Orb::PlanCreatePlanVersionParams::ReplacePrice]?,
        ?set_as_default: bool?,
        ?request_options: Orb::request_opts
      ) -> Orb::PlanVersion

      def fetch: (
        String plan_id,
        ?request_options: Orb::request_opts
      ) -> Orb::Plan

      def fetch_plan_version: (
        String version,
        plan_id: String,
        ?request_options: Orb::request_opts
      ) -> Orb::PlanVersion

      def set_default_plan_version: (
        String plan_id,
        version: Integer,
        ?request_options: Orb::request_opts
      ) -> Orb::Plan

      def initialize: (client: Orb::Client) -> void
    end
  end
end
