module Orb
  module Resources
    class Metrics
      def create: (
        description: String?,
        item_id: String,
        name: String,
        sql: String,
        ?metadata: ::Hash[Symbol, String?]?,
        ?request_options: Orb::request_opts
      ) -> Orb::BillableMetric

      def update: (
        String metric_id,
        ?description: String?,
        ?metadata: ::Hash[Symbol, String?]?,
        ?name: String?,
        ?request_options: Orb::request_opts
      ) -> Orb::BillableMetric

      def list: (
        ?created_at_gt: Time?,
        ?created_at_gte: Time?,
        ?created_at_lt: Time?,
        ?created_at_lte: Time?,
        ?cursor: String?,
        ?limit: Integer,
        ?status: Orb::Models::MetricListParams::status?,
        ?request_options: Orb::request_opts
      ) -> Orb::Internal::Page[Orb::BillableMetric]

      def archive: (
        String metric_id,
        ?request_options: Orb::request_opts
      ) -> Orb::BillableMetric

      def fetch: (
        String metric_id,
        ?request_options: Orb::request_opts
      ) -> Orb::BillableMetric

      def unarchive: (
        String metric_id,
        ?request_options: Orb::request_opts
      ) -> Orb::BillableMetric

      def initialize: (client: Orb::Client) -> void
    end
  end
end
